# ============================================================
# KBEC Apache .htaccess – Root
# ============================================================

Options -Indexes
ServerSignature Off

# ── PHP settings ────────────────────────────────────────────
<IfModule mod_php.c>
    php_value upload_max_filesize  10M
    php_value post_max_size        12M
    php_value max_execution_time   60
    php_value session.cookie_httponly 1
    php_value session.use_strict_mode 1
</IfModule>

# ── Rewrite engine ───────────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /kbec/

    # Redirect index.html → index.php
    RewriteRule ^index\.html$ index.php [R=301,L]

    # Serve existing files/dirs directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
</IfModule>

# ── Security headers ─────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── Block access to sensitive files ─────────────────────────
<FilesMatch "\.(json|sql|md|gitignore|env)$">
    Require all denied
</FilesMatch>

# Block access to data/ and server/ directories
RedirectMatch 403 ^/kbec/data/.*$
RedirectMatch 403 ^/kbec/server/.*$
RedirectMatch 403 ^/kbec/database/migrate\.php$
